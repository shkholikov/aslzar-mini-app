# --- Telegram / Bot ---
BOT_TOKEN=123456:abc...
CHANNEL_ID=-1001234567890
BOT_TELEGRAM_LINK=https://t.me/aslzaruzbot
WEBAPP_URL=https://app.aslzarbot.uz

# --- 1C ERP API ---
API_BASE_URL=http://host:port/AslFIN/hs/serviceOnline/
API_USERNAME=
API_PASSWORD=

# --- MongoDB ---
MONGO_DB_CONNECTION_STRING=mongodb+srv://user:pass@cluster.mongodb.net/
MONGO_DB_NAME=miniapp
# Collection overrides (defaults shown). Use *_dev variants in development.
MONGO_DB_COLLECTION_USERS=users
MONGO_DB_COLLECTION_BROADCAST_JOBS=broadcast_jobs
MONGO_DB_COLLECTION_CHANNEL_POSTS=channel_posts
MONGO_DB_COLLECTION_REMINDER_LOGS=reminder_logs
MONGO_DB_COLLECTION_BESALES_DELIVERIES=besales_deliveries

# --- Besales AI dialog integration (bot-only) ---
# Master switch: ONLY the exact string "true" enables it. Unset/empty/"1" => off (bot behaves as today).
BESALES_ENABLED=false
# Inbound endpoint from Besales provisioning (includes channelId). Bot -> Besales.
BESALES_INBOUND_URL=https://<host>/api/v2/channels/<channelId>/messages
# Bearer key for inbound requests (issued by Besales, shown once).
BESALES_API_KEY=
# Shared secret Besales signs callbacks with; we verify HMAC-SHA256 of the raw body.
BESALES_WEBHOOK_SECRET=
# Path of the callback receiver (the /webhooks/<provider> convention).
BESALES_CALLBACK_PATH=/webhooks/besales
# "Typing…" indicator: wait this long before showing it (fast replies never show typing).
BESALES_TYPING_DELAY_MS=10000
# Max time the "typing…" indicator stays visible before giving up (guards against a missing callback).
BESALES_TYPING_MAX_MS=30000
# HTTP port the callback server binds to. LOCAL ONLY — Railway injects PORT automatically; do not set it there.
PORT=3000
