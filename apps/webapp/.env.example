# Public base URL for the internal API (apps/api). Browser-side, must be NEXT_PUBLIC_*.
# Local dev: http://localhost:3001
# Production: https://api.aslzarbot.uz
NEXT_PUBLIC_API_BASE_URL=https://api.aslzarbot.uz

# Bot deeplink used to render referral links (kept identical for build-time inlining).
NEXT_PUBLIC_BOT_TELEGRAM_LINK=https://t.me/aslzaruzbot

# Local development only. When set, Next proxies /v1/* to a locally-running apps/api instead
# of the browser calling it directly. This is what lets the Mini App be tested through a single
# ngrok tunnel: the phone talks only to this app's public URL, and the API stays on localhost.
# Point NEXT_PUBLIC_API_BASE_URL at this app's own ngrok URL when using it.
# LOCAL_API_PROXY_TARGET=http://localhost:3001

# --- Nothing else belongs here ---
# The webapp is a thin client: it holds no credentials and talks only to apps/api.
#
# In particular, the ASLZAR ID product catalogue key (ASLZAR_ID_API_KEY) and the
# Besales AI-agent credentials live in apps/api and apps/bot, never here. This is a
# browser bundle — anything added to it is readable by anyone who opens devtools,
# and the catalogue's 60 req/min limit is per key, shared across every user at once.
# The catalogue reaches the miniapp through apps/api at /v1/catalog/*.
